rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // IMPORTANT: replace admin@example.com with your verified admin email.
    // This check is enforced on the server, not just in the UI.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == "the.raavanff@gmail.com";
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["displayName", "email", "points", "createdAt"])
        && request.resource.data.points == 0;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName"]);
      allow delete: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid", "tournamentId", "tournamentName", "status", "createdAt"])
        && request.resource.data.status == "Registered"
        && exists(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId))
        && get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.status == "Open";
      allow update, delete: if isAdmin();
    }
  }
}
